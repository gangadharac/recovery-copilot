# Environment Variables for Revenue Recovery Agent
# Optional: Set your Anthropic API Key to use live Claude-3.5-Haiku
# If left unset, Revenue Recovery Agent seamlessly uses the built-in intelligent mock LLM.
ANTHROPIC_API_KEY=

# Default LLM Model
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Razorpay Test Mode Configuration (Phase 4)
# Obtain these from your Razorpay Dashboard -> Settings -> API Keys / Webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Merchant Configuration
MERCHANT_ID=merch_acme_retail_in
MERCHANT_NAME=Acme Retail India

# Guardrail Defaults
MAX_RETRY_LIMIT=3
COOLDOWN_MINUTES=30
DB_PATH=data/recovery_audit.db
