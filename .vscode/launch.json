{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "⚡ Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "app/reporting/dashboard.py"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "🚀 FastAPI Webhook Server",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "🤖 Autonomous Agent Batch (--agent)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_batch.py",
            "args": [
                "--agent"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🔄 Original Batch Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_batch.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 Run All Pytests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
